# 复制为 .env 后填写。按需启用推送渠道，真实凭据只填在 .env 或 GitHub Actions Secrets 中。

# Telegram Bot 推送
# @BotFather 发放的 Bot Token。启用 Bot 推送时与 TELEGRAM_CHAT_ID 一起填写。
TELEGRAM_BOT_TOKEN=
# 目标聊天 ID，支持私聊和群聊。多个 ID 用英文逗号分隔。
TELEGRAM_CHAT_ID=

# Telegram 频道转发
# 要读取的公开频道。可填 aoying999、@aoying999 或 https://t.me/s/aoying999。
TELEGRAM_CHANNEL=aoying999

# 币安合约带单成交监控（仅服务器运行）。PM2 每 45-60 秒随机查询最近 2 天内的最新 10 条，使用公开组合 ID。
BINANCE_COPY_PORTFOLIO_ID=5075281354358777856

# 邮件推送
# SMTP 服务器地址。Gmail 用 smtp.gmail.com，QQ 邮箱用 smtp.qq.com，163 邮箱用 smtp.163.com。
SMTP_HOST=smtp.gmail.com
# SMTP 端口，默认 465，使用 SSL。按邮箱服务商的配置填写。
SMTP_PORT=465
# 发件邮箱的完整地址。
SMTP_USER=
# 发件邮箱的 SMTP 授权码或应用专用密码。
SMTP_PASS=
# 收件邮箱。多个地址用英文逗号分隔，每个地址单独投递。
MAIL_TO=

# 个人微信推送（用于 Telegram 频道转发和币安带单监控）
# Server酱 Turbo 绑定微信后取得的 SendKey。留空则跳过微信推送。
SERVERCHAN_SENDKEY=
# 默认暂停个人微信推送。启用或恢复时填 true。
WECHAT_PUSH_ENABLED=false

# 飞书群推送
# 目标群的自定义机器人 Webhook，格式为 https://open.feishu.cn/open-apis/bot/v2/hook/<token>。
# 留空则跳过飞书推送。
FEISHU_WEBHOOK_URL=
# 群机器人开启「签名校验」时填写签名密钥，否则留空。
FEISHU_WEBHOOK_SECRET=

# 各任务推送渠道（可选，英文逗号分隔；留空使用默认值）
# GitHub 今日涨星和 AI 圈每日要闻当前支持 Telegram Bot。
GITHUB_TRENDING_CHANNELS=telegram
AI_NEWS_CHANNELS=telegram
# 每日潜力股：可选 telegram、email、feishu。
STOCKS_CHANNELS=telegram,email,feishu
# Telegram 频道转发：可选 email、wechat、feishu（微信仍需 WECHAT_PUSH_ENABLED=true）。
TELEGRAM_RELAY_CHANNELS=email,wechat,feishu
# 币安熬鹰资本最近交易监控：可选 email、wechat、feishu。留空沿用 TELEGRAM_RELAY_CHANNELS。
BINANCE_COPY_CHANNELS=

# AI 要闻摘要和潜力股选股（可选）
# Anthropic API Key，用于调用 Claude。
ANTHROPIC_API_KEY=
# OpenAI API Key。两个 API Key 都留空时，AI 要闻和潜力股使用规则排序。
OPENAI_API_KEY=

# Linux PM2 调度
# 用英文逗号分隔任务名。可选 telegram-email、binance-copy、github-trending、ai-news、stocks。
# 下方默认启用频道转发和每日涨星。只跑频道转发时填 telegram-email。
PM2_TASKS=telegram-email,github-trending
