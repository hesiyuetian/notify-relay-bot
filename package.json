{
  "name": "notify-relay-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "每天推送 GitHub 今日涨星、AI 圈要闻，交易日早盘推送潜力股，到 Telegram 和邮箱",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "start": "node dist/github-trending/main.js",
    "dry-run": "node dist/github-trending/main.js --dry-run",
    "stocks": "node dist/stocks/main.js",
    "stocks:dry-run": "node dist/stocks/main.js --dry-run",
    "ai-news": "node dist/ai-news/main.js",
    "ai-news:dry-run": "node dist/ai-news/main.js --dry-run",
    "telegram-email": "node dist/telegram-relay/main.js",
    "telegram-email:dry-run": "node dist/telegram-relay/main.js --dry-run",
    "binance-copy": "node dist/binance-copy/main.js",
    "binance-copy:dry-run": "node dist/binance-copy/main.js --dry-run",
    "binance-copy:resume": "node dist/binance-copy/main.js --resume",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "croner": "^11.0.1",
    "linkedom": "^0.18.15",
    "nodemailer": "^6.9.16"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "typescript": "~5.9.3"
  }
}
